---
const intro = {
  title: "กองทัพมดร่วมปฏิบัติการ",
  subtitle: "“ทำให้รัฐธรรมนูญอยู่ในชีวิตประจำวัน”",
  description: "เป้าหมายหลักของการตั้งคำถาม “ประชาชนอยู่ตรงไหน?” ในปฏิบัติการนี้มีวัตถุประสงค์สำคัญ 3 ประการ",
  objectives: [
    "1. เพื่อตั้งคำถามและกระตุ้นสังคม: จุดประเด็นให้คนในสังคมเกิดความสงสัยและตั้งคำถามว่าขณะนี้กระบวนการจัดทำรัฐธรรมนูญดำเนินไปถึงขั้นตอนไหนแล้ว",
    "2. เพื่อยืนยันสิทธิในการเลือกผู้ร่างรัฐธรรมนูญ: เป็นการแสดงเจตจำนงที่ชัดเจนว่าสมาชิกสภาร่างรัฐธรรมนูญ (สสร.) ต้องมาจากการเลือกตั้งโดยประชาชน ถือเป็นข้อความหลัก (Key Message) สำคัญที่สุดของปฏิบัติการนี้",
    "3. เพื่อสร้างพื้นที่การมีส่วนร่วม: เปิดโอกาสให้คนทั่วไปได้แสดงจุดยืนต่อรัฐธรรมนูญฉบับประชาชนผ่านกิจกรรมในชีวิตประจำวัน เช่น การเดิน การออกกำลังกาย หรือการไปขอพร เพื่อให้คำถามนี้ปรากฏอยู่ในพื้นที่สาธารณะและกลายเป็นส่วนหนึ่งของสังคม ทำให้การรณรงค์กลายเป็นส่วนหนึ่งของกิจกรรมในชีวิตประจำวัน"
  ],
  conclusion: "สรุปสั้นๆ คือการใช้คำถามนี้เป็นเครื่องมือสื่อสารเพื่อคืนอำนาจในการร่างกฎหมายสูงสุดให้กลับมาอยู่ในมือของประชาชน โดยเริ่มจากการทำให้สังคมตระหนักถึงตัวตนและสิทธิของประชาชนในกระบวนการดังกล่าว"
};

const actions = [
  {
    id: "modal-1",
    number: "1",
    title: "ปฏิบัติการ Culture Jamming",
    subtitle: "“ประชาชนอยู่ตรงไหน?”",
    content: [
      "แนวคิดหลัก: การรณรงค์ที่ใช้รูปแบบการ “ป่วน” (Disruption) เพื่อเปลี่ยนความหมายของพื้นที่หรือกิจกรรมในชีวิตประจำวันให้กลายเป็นพื้นที่สื่อสารทางการเมือง",
      "นิยามของ Culture Jamming ในแคมเปญนี้ คือการเข้าไปอยู่ในพื้นที่ปกติ (เช่น ห้างสรรพสินค้า ทางม้าลาย สวนสาธารณะ) แล้วทำให้พื้นที่นั้นเกิดความหมายใหม่ขึ้นมา เช่น การเปลี่ยนจากการไปไหว้พระขอพรปกติ เป็นการ “มู” เพื่อขอให้มี สสร. ที่มาจากการเลือกตั้ง หรือการเต้นแอโรบิกในสวนลุมพินีซึ่งเป็นกิจกรรมปกติที่มีคนรวมตัวกันอยู่แล้วแต่เราเข้าไปใช้พื้นที่และกิจกรรมดังกล่าวเพื่อ “เปลี่ยนความหมายใหม่” ให้กลายเป็นการรณรงค์ทางการเมืองที่ดูเป็นมิตรและเข้าถึงง่าย",
      "เพื่อสื่อสารว่าเรื่องรัฐธรรมนูญเป็นเรื่องของทุกคนที่อยู่ในทุกจังหวะของชีวิต ไม่ใช่เรื่องไกลตัว การเต้นแอโรบิกไม่ใช่แค่การออกกำลังกาย แต่คือการ “ปักป้าย” คำถามสำคัญถึงรัฐธรรมนูญลงไปในกิจกรรมที่เรียบง่ายที่สุดของประชาชน"
    ]
  },
  {
    id: "modal-2",
    number: "2",
    title: "Everyday Campaign",
    subtitle: "การรณรงค์ในชีวิตประจำวัน",
    content: [
      "แนวคิดหลัก: ฉันคืออุปกรณ์รณรงค์ ฉันคือแคมเปญ เป็นการเปลี่ยนให้ตัวเองกลายเป็นสื่อเคลื่อนที่ในการสื่อสารประเด็นรัฐธรรมนูญผ่านการใช้ชีวิตปกติ เช่น สวมเสื้อที่มีสัญลักษณ์ ติดสติ๊กเกอร์ ติดบิบวิ่ง รวมไปถึงการนำป้ายแขวนไปแขวนตามจุดต่างๆ เพื่อให้คำถามนี้ปรากฏในพื้นที่สาธารณะอย่างต่อเนื่องในทุกที่ที่ประชาชนใช้ชีวิตอยู่ โดยไม่ต้องรอให้มีการชุมนุมใหญ่"
    ]
  },
  {
    id: "modal-3",
    number: "3",
    title: "Take Our Action!",
    subtitle: "แสดงจุดยืนด้วยตัวเอง",
    content: [
      "แนวคิดหลัก: การแสดงจุดยืนของตัวเองที่มากกว่าการลงชื่อ เป็นขั้นที่ยกระดับจากการเป็นเพียง “สื่อ” ไปสู่การ ลงมือทำ (Action) ด้วยตัวเองเพื่อยืนยันสิทธิและเจตจำนงที่มีต่อรัฐธรรมนูญ สร้างพื้นที่ให้คนทั่วไปได้ยืนยันเจตจำนง “ประชาชนต้องได้เลือกผู้ร่างรัฐธรรมนูญ” อย่างเป็นรูปธรรมในฐานะปัจเจกบุคคล",
      "เป็นการเปลี่ยนบทบาทของประชาชนจาก “สื่อ” ที่แค่ติดสติ๊กเกอร์หรือแขวนป้าย มาเป็น “ผู้ลงมือกระทำ” (Actor) ที่ต้องการประกาศจุดยืนเรื่องการเลือกตั้ง สสร. ด้วยวิธีการของตนเอง เพื่อให้คำถามที่ว่า “ประชาชนอยู่ตรงไหน?” ได้รับคำตอบผ่านการกระทำของประชาชนนั่นเอง"
    ]
  }
];
---

<div class="max-w-6xl mx-auto px-4 py-12 font-sans text-gray-800">
  
  <header class="mb-12 text-center max-w-4xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold mb-2 text-gray-900">{intro.title}</h1>
    <h2 class="text-xl md:text-2xl font-semibold mb-6 text-indigo-600">{intro.subtitle}</h2>
    
    <div class="text-left text-xs bg-gray-50 p-6 rounded-xl shadow-sm border border-gray-100">
      <p class="font-medium mb-4">{intro.description}</p>
      <ul class="space-y-3 mb-6">
        {intro.objectives.map((obj) => (
          <li class="pl-4 border-l-4 border-indigo-400">{obj}</li>
        ))}
      </ul>
      <p class="font-semibold text-gray-700">{intro.conclusion}</p>
    </div>
  </header>

  <div class="flex flex-col md:flex-row gap-6 items-stretch">
    {actions.map((action) => (
      <button 
        class="flex-1 bg-white border border-gray-200 rounded-2xl p-6 text-left shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 group focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
        data-open-modal={action.id}
      >
        <div class="text-4xl font-black text-indigo-100 mb-4 group-hover:text-indigo-200 transition-colors">
          {action.number}
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight">
          {action.title}
        </h3>
        <p class="text-gray-600 text-sm">
          {action.subtitle}
        </p>
        <div class="mt-6 flex items-center text-indigo-600 text-sm font-semibold">
          อ่านรายละเอียด 
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </button>
    ))}
  </div>

  {actions.map((action) => (
    <dialog 
      id={action.id} 
      class="backdrop:bg-black/60 rounded-2xl shadow-2xl p-0 w-full max-w-2xl border-0 m-auto"
    >
      <div class="p-6 md:p-8 bg-white relative">
        <button 
          data-close-modal 
          class="absolute top-4 right-4 p-2 text-gray-400 hover:text-gray-900 hover:bg-gray-100 rounded-full transition-colors focus:outline-none"
          aria-label="Close"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        
        <div class="mb-6">
          <span class="inline-block px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm font-bold mb-3">
            ปฏิบัติการที่ {action.number}
          </span>
          <h2 class="text-2xl font-bold text-gray-900 mb-1">{action.title}</h2>
          <h3 class="text-lg text-gray-600">{action.subtitle}</h3>
        </div>
        
        <div class="space-y-4 text-gray-700 leading-relaxed">
          {action.content.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </dialog>
  ))}
</div>

<script>
  // ส่วนของ JavaScript สำหรับจัดการเปิด-ปิด Modal
  function setupModals() {
    const openButtons = document.querySelectorAll('[data-open-modal]');
    const closeButtons = document.querySelectorAll('[data-close-modal]');

    // เปิด Modal ตาม ID
    openButtons.forEach(button => {
      button.addEventListener('click', () => {
        const modalId = button.getAttribute('data-open-modal');
        const modal = document.getElementById(modalId) as HTMLDialogElement;
        if (modal) {
          modal.showModal();
          // ล็อกการเลื่อนหน้าจอเมื่อเปิด Modal
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // ปิด Modal
    closeButtons.forEach(button => {
      button.addEventListener('click', () => {
        const modal = button.closest('dialog') as HTMLDialogElement;
        if (modal) {
          modal.close();
          // คืนค่าการเลื่อนหน้าจอ
          document.body.style.overflow = '';
        }
      });
    });

    // กดคลิกพื้นที่สีดำ (Backdrop) เพื่อปิด
    document.querySelectorAll('dialog').forEach(dialog => {
      dialog.addEventListener('click', (e) => {
        const dialogDimensions = dialog.getBoundingClientRect()
        if (
          e.clientX < dialogDimensions.left ||
          e.clientX > dialogDimensions.right ||
          e.clientY < dialogDimensions.top ||
          e.clientY > dialogDimensions.bottom
        ) {
          dialog.close();
          document.body.style.overflow = '';
        }
      });
    });
  }

  // รันฟังก์ชันเมื่อโหลดหน้าเสร็จ (รองรับ Astro View Transitions ด้วย)
  setupModals();
  document.addEventListener('astro:page-load', setupModals);
</script>