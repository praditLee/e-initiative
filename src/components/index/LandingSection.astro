---
import Config from '../../../e-initiative.config.mjs';
import SectionContainer from '../SectionContainer.astro';
import UpdateTimestamp from '../UpdateTimestamp.svelte';
import PenIcon from '../icons/PenIcon.svelte';
import LocationIcon from '../icons/LocationIcon.svelte';
import TableIcon from '../icons/TableIcon.svelte';
import { dayElapsed, isCampaignEnded } from '../../utils/campaign';
import { countSubmittedDocuments } from '../../utils/firebase';
import { countOfflineSignatures } from '../../utils/sheets';
import Sharer from '../Sharer.svelte';

// const documentCount =
// 	(await countSubmittedDocuments()) 
	// +
	// (Config.sheets?.enableOfflineSignature ? await countOfflineSignatures() : 0);
---

<SectionContainer
	outerClass="min-h-screen justify-center bg-info"
	innerClass="flex flex-col gap-16 text-center md:flex-row"
	hideNavbar
>
	<div class="flex flex-col items-center justify-center">
		<h1 class="heading-responsive-02">"โหวตโน"</h1>
		<h2 class="text-xl font-bold text-primary">
			ไม่รับกับ สสร. ที่เราไม่ได้เลือก
		</h2>
		<img
			class="mt-4 w-[400px] md:w-[600px]"
			src="/images/where-people.png"
			alt="ประชาชนอยู่ตรงไหนในกระบวนการนี้"
		/>
	</div>
	<div class="my-auto flex w-full max-w-md flex-col space-y-2">
		<p class="mt-1">
			ต้องการ {Config.petition.expectedSignatures.toLocaleString()} รายชื่อ
		</p>

		<div class="flex flex-col gap-2">
			<div>
				<p class="heading-responsive-01">
    			ประกาศเจตนารมณ์แล้ว<br /> <span id="realtime-count" class="font-bold text-5xl">...</span> คน
				</p>
				<p>
					{dayElapsed > 0 && <>เหลือเวลาอีก {dayElapsed} วัน</>}
					(ภายใน {
						Config.petition.endDate.toLocaleDateString('TH-th', {
							dateStyle: 'medium',
						})
					})
				</p>
			</div>
			<UpdateTimestamp client:load date={new Date()} />
			{
				isCampaignEnded ? (
					<div class="flex flex-row items-center gap-2">
						<div class="h-[2px] flex-1 bg-secondary" />
						<p class="font-bold text-secondary">ปิดรับลงชื่อแล้ว</p>
						<div class="h-[2px] flex-1 bg-secondary" />
					</div>
				) : (
					<a
							href="#sign"
							class="heading-03 btn btn-primary btn-block text-base-100"
						>
							ลงชื่อประกาศเจตนารมณ์
							<PenIcon />
						</a>
						<div class="divider" />
					<div class="space-y-2">
						<a
							href="https://conforall.com/"
							target="_blank"
							class="heading-03 btn btn-block bg-[#30C661] text-[#F8EB52] border border-black hover:bg-green-600"
						>
							ร่วมลงชื่อเพื่อเสนอร่างฯ ประชาชน
							<img
								src="/images/star_icon.png"
								alt="ConForAll Logo"
								class="inline h-6 w-6"
							/>
						</a>
						
						{/* {Config.sheets?.enableLocations && (
							<a
								href="locations"
								class="heading-03 btn btn-secondary btn-block"
							>
								ดูสถานที่ลงชื่อ
								<LocationIcon />
							</a>
						)}  */}
						{Config.petition.offline?.volunteer && (
							<a
								href="#volunteer"
								class="heading-03 btn btn-secondary btn-block"
							>
								ร่วมเป็นอาสาปฎิบัติการ
								<TableIcon />
							</a>
						)}
					</div>
				)
			}
		</div>
		<div class="flex flex-row items-center gap-2 wrap justify-center">
				
			<a href="#why" class="heading-03 btn btn-link  hover:text-accent"
				>ทำไมต้องประกาศเจตนารมย์</a
			>|
			<a href="/word" target="_blank" class="heading-03 btn btn-link  hover:text-accent"
				>ดูคำประกาศกองทัพมด</a
			>
		</div>
		

		<div class="flex items-center justify-center gap-3 text-primary">
			<span class="body-01">แชร์</span>
			<Sharer />
		</div>
	</div>
</SectionContainer>
<script>
    import { countSubmittedDocuments } from '../../utils/firebase';

    // ฟังก์ชันนี้จะทำงานบนเบราว์เซอร์ของผู้ใช้
    async function fetchRealtimeCount() {
        try {
            const count = await countSubmittedDocuments();
            const countElement = document.getElementById('realtime-count');
            
            if (countElement) {
                // ใส่ลูกน้ำให้ตัวเลขดูอ่านง่าย (เช่น 1,000)
                countElement.innerText = count.toLocaleString(); 
            }
        } catch (error) {
            console.error("ไม่สามารถดึงยอดผู้ลงชื่อได้:", error);
            const countElement = document.getElementById('realtime-count');
            if (countElement) countElement.innerText = "0";
        }
    }

    // สั่งให้ฟังก์ชันทำงานทันทีที่โหลดหน้าเว็บ
    fetchRealtimeCount();
</script>