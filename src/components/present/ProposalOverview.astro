        <div class="flex justify-between items-center mt-6 md:hidden px-2">
            <button id="btnPrev" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-full font-bold shadow-sm transition">
                &#8592; ก่อนหน้า
            </button>
            <span id="slideIndicator" class="font-bold text-[#2e4394]">1 / 5</span>
            <button id="btnNext" class="bg-[#2e4394] hover:bg-blue-800 text-white px-4 py-2 rounded-full font-bold shadow-sm transition">
                ถัดไป &#8594;
            </button>
        </div>
    </div>
</div>


</div>

<script>
    function initCarousel() {
        const track = document.getElementById('sliderTrack');
        const indicator = document.getElementById('slideIndicator');
        const btnNext = document.getElementById('btnNext');
        const btnPrev = document.getElementById('btnPrev');

        if (!track || !btnNext || !btnPrev) return;

        let currentIndex = 0;
        const totalItems = 5;

        // --- ตัวแปรสำหรับจับการปัดนิ้ว (Swipe) ---
        let touchStartX = 0;
        let touchEndX = 0;
        const swipeThreshold = 50; // ระยะปัดขั้นต่ำ (พิกเซล) ถึงจะเลื่อนสไลด์

        function updateSlider() {
            if (window.innerWidth < 768) {
                track.style.transform = `translateX(-${currentIndex * 100}%)`;
                indicator.innerText = `${currentIndex + 1} / ${totalItems}`;
            }
        }

        function goNext() {
            if (currentIndex < totalItems - 1) {
                currentIndex++;
                updateSlider();
            }
        }

        function goPrev() {
            if (currentIndex > 0) {
                currentIndex--;
                updateSlider();
            }
        }

        // --- Event Listener สำหรับปุ่มกด ---
        btnNext.addEventListener('click', goNext);
        btnPrev.addEventListener('click', goPrev);

        // --- Event Listener สำหรับการปัดนิ้ว (Touch) ---
        track.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        track.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        }, { passive: true });

        function handleSwipe() {
            const swipeDistance = touchStartX - touchEndX;

            // ถ้าปัดไปทางซ้าย (ค่าบวก และเกินระยะที่กำหนด) -> ไปสไลด์ถัดไป
            if (swipeDistance > swipeThreshold) {
                goNext();
            } 
            // ถ้าปัดไปทางขวา (ค่าลบ และเกินระยะที่กำหนด) -> กลับสไลด์ก่อนหน้า
            else if (swipeDistance < -swipeThreshold) {
                goPrev();
            }
        }

        // --- จัดการเมื่อมีการหมุนจอหรือเปลี่ยนขนาดจอ ---
        window.addEventListener('resize', () => {
            if (window.innerWidth >= 768) {
                track.style.transform = 'none';
            } else {
                updateSlider();
            }
        });
    }

    // รองรับการโหลดหน้าเว็บทั้งแบบปกติและแบบ View Transitions ของ Astro
    initCarousel();
    document.addEventListener('astro:page-load', initCarousel);
</script>