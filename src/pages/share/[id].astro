---
import Layout from '../../layouts/Body.astro';
import ShareArtwork from '../../components/ShareArtwork.svelte';
import BackHomeLink from '../../components/BackHomeLink.astro';

// ฟังก์ชันนี้บอกให้ Astro รู้ว่าเรามี Artwork กี่รูป (สมมติว่ามี 3 รูป)
export function getStaticPaths() {
    return [
        { params: { id: '1' } },
        { params: { id: '2' } },
        { params: { id: '3' } },
        { params: { id: '4' } },
        { params: { id: '5' } },
    ];
}

const { id } = Astro.params;
const ogImage = `/art${id}.jpg`; // ดึงรูปตาม ID ไปทำ Meta Tags
import GalleryGrid from '../../components/GalleryGrid.svelte';
const files = import.meta.glob('/public/medias/*.{png,jpg,jpeg,webp,pdf}', { eager: true });
const fileUrls = Object.keys(files).map(path => path.replace('/public', ''));
---

<Layout title={`ร่วมประกาศจุดยืน - `} image={ogImage}>
    <BackHomeLink class="absolute left-1 top-3" />
    <main class="container mx-auto p-4 max-w-xl mt-10 text-center">
        <h1 class="text-2xl font-bold mb-2 text-success">ร่วมรณรงค์และกระจายข่าว!</h1>
        <p class="mb-4 text-lg">
            เสียงของคุณสำคัญมาก ร่วมประกาศจุดยืนให้สังคมรับรู้!
        </p>
        
        <ShareArtwork currentId={Number(id)} client:load />
        <h1 class="text-2xl font-bold mb-2 text-success">ดาวน์โหลดสื่อไปใช้งาน</h1>
        <GalleryGrid 
				items={fileUrls} 
				limit={0} 
				random={true} 
				client:load 
			/>
    </main>
</Layout>