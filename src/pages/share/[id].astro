---
import Layout from '../../layouts/Body.astro';
import ShareArtwork from '../../components/ShareArtwork.svelte';

// ฟังก์ชันนี้บอกให้ Astro รู้ว่าเรามี Artwork กี่รูป (สมมติว่ามี 3 รูป)
export function getStaticPaths() {
    return [
        { params: { id: '1' } },
        { params: { id: '2' } },
        { params: { id: '3' } },
        { params: { id: '4' } },
        { params: { id: '5' } },
    ];
}

const { id } = Astro.params;
const ogImage = `/art${id}.jpg`; // ดึงรูปตาม ID ไปทำ Meta Tags
---

<Layout title={`ร่วมประกาศจุดยืน - แบบที่ ${id}`} image={ogImage}>
    <main class="container mx-auto p-4 max-w-xl mt-10 text-center">
        <h1 class="text-2xl font-bold mb-2 text-success">ลงชื่อสำเร็จ!</h1>
        <p class="mb-4 text-lg">
            เสียงของคุณสำคัญมาก ร่วมประกาศจุดยืนให้สังคมรับรู้!
        </p>
        
        <ShareArtwork currentId={Number(id)} client:load />
    </main>
</Layout>