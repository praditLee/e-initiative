---
import Layout from '../layouts/Body.astro';
import ShareArtwork from '../components/ShareArtwork.svelte';
// คุณสามารถเปลี่ยน URL เป็นลิงก์เว็บไซต์จริงของคุณได้ในอนาคต
const shareUrl = "https://yourwebsite.com"; 
const shareText = "ฉันขอประกาศจุดยืน ไม่เอาด้วยกับการร่างรัฐธรรมนูญที่ไม่ใส่ใจเสียงของประชาชน! มาร่วมลงชื่อได้ที่นี่";
---

<Layout title="แชร์จุดยืนของคุณ">
    <main class="container mx-auto p-4 max-w-2xl mt-10 text-center">
        <h1 class="text-3xl font-bold mb-4 text-success">ลงชื่อสำเร็จ! ขอบคุณที่เป็นส่วนหนึ่ง</h1>
        <p class="mb-8 text-lg">
            เสียงของคุณสำคัญมาก แต่จะทรงพลังยิ่งขึ้นหากสังคมได้รับรู้ 
            <br/>ร่วมประกาศจุดยืนของคุณผ่านโซเชียลมีเดียได้เลย!
        </p>
        
        <div class="bg-base-200 p-6 rounded-lg mb-8 shadow-md">
            <div class="w-full h-80 bg-gray-300 flex items-center justify-center rounded-lg mb-6 overflow-hidden">
                <span class="text-gray-500 font-bold">พื้นที่แสดงภาพ Artwork ที่คุณออกแบบ</span>
            </div>
            
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a 
                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="btn bg-[#1877F2] text-white hover:bg-[#0C63D4] border-none"
                >
                    แชร์ลง Facebook
                </a>
                
                <a 
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="btn bg-black text-white hover:bg-gray-800 border-none"
                >
                    แชร์ลง X
                </a>
            </div>

            <!-- โหลด UI แบบ Interactive -->
        <ShareArtwork client:load />
        </div>
        
        <a href="/" class="btn btn-ghost underline">กลับสู่หน้าแรก</a>
    </main>
</Layout>