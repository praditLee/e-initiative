---
// ส่วนที่ 1: นำเข้า Layout และปุ่ม Svelte ที่เราเพิ่งสร้าง
import Layout from '../layouts/Body.astro';
import AdminPanel from '../components/AdminPanel.svelte';
---

<Layout title="Admin Dashboard | จัดการข้อมูล">
    <main class="container mx-auto p-4 max-w-2xl mt-10">
        <h1 class="text-3xl font-bold mb-6 text-center text-primary">
            แผงควบคุมสำหรับแอดมิน
        </h1>
        
        <p class="text-center mb-8">
            หน้านี้ใช้สำหรับส่งข้อมูลรายชื่อที่คัดกรองแล้วไปยัง Google Sheets
        </p>

        <AdminPanel client:load />
        
    </main>
</Layout>